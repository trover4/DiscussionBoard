@model DiscussionBoard.Models.DiscussionThread

<div class="card mb-3">
    <div class="card-body">
        <h5 class="card-title">@Model.Title</h5>

        <p class="card-text">
            @Model.Content
        </p>

        <small class="text-muted">
            Created: @Model.CreatedAt.ToLocalTime()
        </small>
    </div>
</div>

<a asp-page="/Discussions/Details"
   asp-route-threadId="@Model.Id"
   class="btn btn-outline-primary">
    Discussion
</a>
