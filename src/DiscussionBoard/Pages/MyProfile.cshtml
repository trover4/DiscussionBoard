@page
@model DiscussionBoard.Pages.MyProfile
@using DiscussionBoard.Services

@{
    ViewData["Title"] = "My Profile";
}

<h1>My Profile</h1>

@if (!string.IsNullOrEmpty(Model.SuccessMessage))
{
    <div class="alert alert-success" role="status">
        @Model.SuccessMessage
    </div>
}

<form method="post">
    <div asp-validation-summary="ModelOnly"
         class="text-danger"></div>

    <div class="mb-3">
        <label asp-for="Profile.DisplayName" class="form-label">Display Name</label>

        <input asp-for="Profile.DisplayName" class="form-control"/>

        <span asp-validation-for="Profile.DisplayName" class="text-danger"></span>
    </div>

    <fieldset class="mb-3">
        <legend>Choose and Avatar</legend>

        <p>Current Avatar</p>
        <img src="@AvatarCatalog.ImagePath(Model.Profile.AvatarId)"
             alt="Current Avatar"
             width="80"
             height="80"/>

        <div class="row mt-3">
            @foreach (var avatar in AvatarCatalog.Options)
            {
                <div class="col-auto text-center mb-3">
                    <label>
                        <img src="@AvatarCatalog.ImagePath(avatar.Id)"
                             alt="@avatar.DisplayName"
                             width="64"
                             height="64"
                             class="d-block mb-2"/>

                        <input type="radio"
                               asp-for="Profile.AvatarId"
                               value="@avatar.Id"/>

                        @avatar.DisplayName
                    </label>
                </div>
            }
        </div>

        <span asp-validation-for="Profile.AvatarId"
              class="text-danger"></span>
    </fieldset>

    <button type="submit" class="btn btn-primary">
        Save Profile
    </button>
</form>

@section Scripts
{
    <partial name="_ValidationScriptsPartial" />
}
