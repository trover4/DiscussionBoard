@page
@model DiscussionBoard.Pages.Discussions.Create

@{ViewData["Title"] = "Create Discussion"; }

<h1> Create Discussion </h1>

<form method="post">
    <input type="hidden" asp-for="ForumId" />

    <div asp-validation-summary="ModelOnly"
         class="text-danger"></div>

    <div class="mb-3">
        <label asp-for="Input.Title"
               class="form-label"></label>
        <input asp-for="Input.Title"
               class="form-control" />
        <span asp-validation-for="Input.Title"
              class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Input.Content"
               class="form-label"></label>
        <textarea asp-for="Input.Content"
                  class="form-control"
                  rows="6"></textarea>
        <span asp-validation-for="Input.Content"
              class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-primary">
        Create Discussion
    </button>
</form>
